# Q7 Maximum sum of subarray
arr=list(map(int,input().split()))
m=arr[0]
c=arr[0]
for i in arr[1:]:
    c=max(i,c+i)
    m=max(m,c)
print(m)

# Q8 Search Insert Position
arr=list(map(int,input().split()))
t=int(input())
l=0
h=len(arr)-1
while l<=h:
    mid=(l+h)//2
    if arr[mid]==t:
        print(mid)
        break
    elif arr[mid]<t:
        l=mid+1
    else:
        h=mid-1
else:
    print(l)

# Q9 Two Sum
arr=list(map(int,input().split()))
t=int(input())
d={}
for i in range(len(arr)):
    if t-arr[i] in d:
        print([d[t-arr[i]],i])
        break
    d[arr[i]]=i

# Q10 Minimum number of jumps to reach end
arr=list(map(int,input().split()))
n=len(arr)
c=0
e=0
m=0
for i in range(n-1):
    m=max(m,i+arr[i])
    if i==e:
        c+=1
        e=m
        if e>=n-1:
            print(c)
            break
else:
    print(-1)
