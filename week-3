Q7 Spiral traversal of matrix
n,m=map(int,input().split())
mat=[list(map(int,input().split())) for _ in range(n)]
t,b,l,r=0,n-1,0,m-1
res=[]
while t<=b and l<=r:
    for i in range(l,r+1):res.append(mat[t][i])
    t+=1
    for i in range(t,b+1):res.append(mat[i][r])
    r-=1
    if t<=b:
        for i in range(r,l-1,-1):res.append(mat[b][i])
        b-=1
    if l<=r:
        for i in range(b,t-1,-1):res.append(mat[i][l])
        l+=1
print(res)

Q8 Search a 2D matrix
n,m=map(int,input().split())
mat=[list(map(int,input().split())) for _ in range(n)]
t=int(input())
l=0
h=n*m-1
while l<=h:
    mid=(l+h)//2
    if mat[mid//m][mid%m]==t:
        print(True)
        break
    elif mat[mid//m][mid%m]<t:
        l=mid+1
    else:
        h=mid-1
else:
    print(False)

