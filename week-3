Q2 Smallest subarray with sum greater than x
x=int(input())
arr=list(map(int,input().split()))
s=0
l=0
ans=len(arr)+1
for r in range(len(arr)):
    s+=arr[r]
    while s>x:
        ans=min(ans,r-l+1)
        s-=arr[l]
        l+=1
print(ans if ans!=len(arr)+1 else 0)

Q3 Three way partitioning of array
arr=list(map(int,input().split()))
a,b=map(int,input().split())
l=0
r=len(arr)-1
i=0
while i<=r:
    if arr[i]<a:
        arr[i],arr[l]=arr[l],arr[i]
        l+=1
        i+=1
    elif arr[i]>b:
        arr[i],arr[r]=arr[r],arr[i]
        r-=1
    else:
        i+=1
print(arr)

Q4 Minimum swaps to bring elements <=k together
arr=list(map(int,input().split()))
k=int(input())
c=0
for i in arr:
    if i<=k:
        c+=1
b=0
for i in range(c):
    if arr[i]>k:
        b+=1
ans=b
i=0
j=c
while j<len(arr):
    if arr[i]>k:
        b-=1
    if arr[j]>k:
        b+=1
    ans=min(ans,b)
    i+=1
    j+=1
print(ans)

