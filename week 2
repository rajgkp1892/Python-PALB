Q2 Minimize the heights of towers
k=int(input())
arr=list(map(int,input().split()))
arr.sort()
ans=arr[-1]-arr[0]
s=arr[0]+k
l=arr[-1]-k
for i in range(len(arr)-1):
    mn=min(s,arr[i+1]-k)
    mx=max(l,arr[i]+k)
    if mn>=0:
        ans=min(ans,mx-mn)
print(ans)

Q3 Minimum number of jumps to reach end
arr=list(map(int,input().split()))
n=len(arr)
c=0
e=0
m=0
for i in range(n-1):
    m=max(m,i+arr[i])
    if i==e:
        c+=1
        e=m
        if e>=n-1:
            print(c)
            break
else:
    print(-1)

