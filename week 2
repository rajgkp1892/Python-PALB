Q10 Triplet sum equals target
arr=list(map(int,input().split()))
t=int(input())
arr.sort()
f=False
for i in range(len(arr)-2):
    l=i+1
    r=len(arr)-1
    while l<r:
        s=arr[i]+arr[l]+arr[r]
        if s==t:
            f=True
            break
        elif s<t:
            l+=1
        else:
            r-=1
    if f:
        break
print(f)

Q11 Trapping rain water
arr=list(map(int,input().split()))
l=0
r=len(arr)-1
lm=rm=0
w=0
while l<r:
    if arr[l]<arr[r]:
        if arr[l]>=lm:
            lm=arr[l]
        else:
            w+=lm-arr[l]
        l+=1
    else:
        if arr[r]>=rm:
            rm=arr[r]
        else:
            w+=rm-arr[r]
        r-=1
print(w)
